@model Entity.Class.User
@{
    ViewData["Title"] = "Kullanıcı Girişi";
    Layout = null;
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

    <style>
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f8f9fa, #e0e0e0);
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        .fullscreen-container {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 15px;
        }

        .login-card {
            background-color: #ffffff;
            border-radius: 20px;
            border: none;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            width: 100%;
            max-width: 600px;
            max-height:800 px;
            overflow: hidden;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

            .login-card:hover {
                transform: translateY(-5px);
                box-shadow: 0 15px 40px rgba(0,0,0,0.2);
            }

        .login-header {
            background: linear-gradient(90deg, #8B0000, #b22222);
            color: white;
            padding: 25px;
            text-align: center;
            font-size: 24px;
            font-weight: bold;
        }

        .login-body {
            padding: 50px 45px;
        }

        .form-label {
            font-weight: 500;
        }

        .form-control {
            border-radius: 10px;
            transition: all 0.3s ease;
        }

            .form-control:focus {
                border-color: #8B0000;
                box-shadow: 0 0 8px rgba(139,0,0,0.2);
            }

        .btn-custom {
            background: #8B0000;
            border: none;
            border-radius: 14px;
            padding: 12px;
            font-weight: 600;
            transition: all 0.3s ease;
        }

            .btn-custom:hover {
                background: #a40000;
                transform: translateY(-2px);
                box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            }

        .text-center-small {
            text-align: center;
            font-size: 14px;
            color: #666;
            margin-top: 15px;
        }

            .text-center-small a {
                color: #8B0000;
                text-decoration: none;
            }

                .text-center-small a:hover {
                    text-decoration: underline;
                }
    </style>
    >
    <meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
    <meta http-equiv="Pragma" content="no-cache" />
    <meta http-equiv="Expires" content="0" />
</head>
<body>
    <div class="fullscreen-container">
        <div class="card login-card">
            <div class="login-header">
                Hoşgeldiniz
            </div>
            <div class="login-body">
                <h5 class="text-center mb-4" style="color: #333;">Giriş Yap</h5>
                <form asp-action="Login" method="post">
                    <div class="mb-3">
                        <label asp-for="KullaniciAdi" class="form-label">Kullanıcı Adı</label>
                        <input asp-for="KullaniciAdi" class="form-control" placeholder="Kullanıcı adınızı girin" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Password" class="form-label">Şifre</label>
                        <input asp-for="Password" type="password" class="form-control" placeholder="Şifrenizi girin" />
                    </div>

                    <button type="submit" class="btn btn-custom text-white w-100 mt-3">Giriş Yap</button>
                </form>
                @if (TempData["LoginError"] != null)
                {
                    <div class="position-fixed top-0 start-0 p-3" style="z-index: 1050;">
                        <div class="toast align-items-center text-bg-danger border-0 show" role="alert" aria-live="assertive" aria-atomic="true">
                            <div class="d-flex">
                                <div class="toast-body">
                                    @TempData["LoginError"]
                                </div>
                                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Close"></button>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</body>
</html>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
