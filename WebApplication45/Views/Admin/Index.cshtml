@model List<Entity.Class.Uruns>
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>Admin Panel</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body {
            margin: 0;
            font-family: 'Segoe UI', 'Calibri', sans-serif;
            background-color: #f5f5f5;
            transition: margin-left 0.3s ease;
        }
        /* Sidebar */
        .sidebar {
            width: 250px;
            height: 100vh;
            background-color: #8B0000;
            color: #ecf0f1;
            position: fixed;
            top: 0;
            left: 0;
            padding: 20px;
            overflow-y: auto;
            transition: all 0.3s ease;
            box-shadow: 2px 0 8px rgba(0,0,0,0.2);
            z-index: 100;
        }

            .sidebar.collapsed {
                width: 0;
                padding: 0;
                overflow: hidden;
            }

        #menuToggle {
            position: fixed;
            top: 15px;
            left: 15px;
            z-index: 1100;
            background-color: #9B0000;
            color: #ecf0f1;
            border: none;
            padding: 8px 12px;
            font-size: 18px;
            cursor: pointer;
            border-radius: 4px;
            box-shadow: 0 2px 6px rgba(0,0,0,0.2);
        }

        header {
            background-color: #8B0000;
            color: #ffffff;
            padding: 15px 20px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
            position: sticky;
            top: 0;
            z-index: 90;
        }

        #adminTitle {
            font-size: 24px;
            letter-spacing: 1px;
            font-weight: 600;
            text-align: center;
        }

        .header-right {
            position: absolute;
            right: 20px;
        }

            .header-right a {
                color: #ecf0f1;
                text-decoration: none;
            }

        .content {
            margin-left: 250px;
            padding: 25px;
            transition: margin-left 0.3s ease;
        }

        body.sidebar-collapsed .content {
            margin-left: 0;
        }
        /* Tablo */
        .table-container {
            background-color: #ffffff;
            padding: 25px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
            margin-top: 30px;
        }

        table {
            border-collapse: separate;
            border-spacing: 0 8px;
        }

        thead {
            background-color: #8B0000;
            color: white;
        }

        th, td {
            padding: 14px;
            text-align: left;
        }

        tbody tr {
            background-color: #fdfdfd;
            transition: background-color 0.2s;
        }

            tbody tr:hover {
                background-color: #ecf0f1;
            }

        .btn-primary, .btn-warning, .btn-danger {
            border-radius: 6px;
            font-size: 0.9rem;
        }

        .btn-warning {
            background-color: #8B0000;
            color: white;
        }

            .btn-warning:hover {
                background-color: #2980B9;
            }

        .btn-danger {
            background-color: #E74C3C;
            color: white;
        }

            .btn-danger:hover {
                background-color: #C0392B;
            }
        /* Floating Add Button */
        .fab {
            position: fixed;
            bottom: 30px;
            right: 30px;
            width: 60px;
            height: 60px;
            border-radius: 50%;
            font-size: 32px;
            font-weight: bold;
            text-align: center;
            line-height: 60px;
            background-color: #3498DB;
            color: white;
            box-shadow: 0 4px 10px rgba(0,0,0,0.3);
            transition: background-color 0.3s, transform 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            text-decoration: none;
        }

            .fab:hover {
                background-color: #2980B9;
                transform: scale(1.1);
                text-decoration: none;
            }

        table th, table td {
            font-size: 0.85rem;
            padding: 10px;
        }

        .btn {
            font-size: 0.75rem;
            padding: 5px 10px;
        }
    </style>
</head>
<body>
    <button id="menuToggle" onclick="toggleSidebar()">☰</button>

    <!-- Sidebar -->
    <nav class="sidebar" id="sidebar">
        <h5>Menü</h5>
        <hr style="border-color: rgba(236,240,241,0.3);" />
        @await Component.InvokeAsync("CascadingDropdown")
    </nav>

    <header>
        <h1 id="adminTitle">Admin Panel</h1>
        <div class="header-right">
            @if (User.Identity.IsAuthenticated)
            {
                <a href="/Account/LogoutConfirm" class="btn btn-danger">Çıkış</a>
            }
        </div>
    </header>

    <div class="content">
        <div class="table-container" id="urunTablosu">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Ürün Kodu</th>
                        <th>Ürün Adı</th>
                        <th>Ürün Fiyatı</th>
                        <th>Ürün Stoğu</th>
                        <th>İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var urun in Model)
                    {
                        <tr>
                            <td>@urun.Id</td>
                            <td>@urun.UrunKodu</td>
                            <td>@urun.UrunAdi</td>
                            <td>@urun.UrunFiyat.ToString("C")</td>
                            <td>@urun.UrunAdedi</td>
                            <td>
                                <a asp-action="EditProduct" asp-route-id="@urun.Id" class="btn btn-warning">Düzenle</a>
                                <a asp-action="DeleteProduct" asp-controller="Admin" asp-route-id="@urun.Id" class="btn btn-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <a asp-action="Create" asp-controller="Admin" class="fab">+</a>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const body = document.body;
        const sidebar = document.getElementById('sidebar');

        function toggleSidebar() {
            sidebar.classList.toggle('collapsed');
            body.classList.toggle('sidebar-collapsed');
        }
    </script>
</body>
</html>

